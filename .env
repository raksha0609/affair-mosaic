# Environment variables for AFFAIR Mosaic Reconstruction
# This file contains configuration variables for the project

# Set to True for debug mode
DEBUG=False

# Path to data directory (relative to project root)
DATA_DIR=data/

# Path to results directory
RESULTS_DIR=results/

# Default grid size for mosaics
DEFAULT_GRID=10

# Default coarse resolution
DEFAULT_COARSE=200

# Default metric (ssim, lab, mse, hybrid)
DEFAULT_METRIC=hybrid

# Default top-k candidates
DEFAULT_TOPK=5